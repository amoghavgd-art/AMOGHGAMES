{
  "name": "playglow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/build-cart.mjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc -b",
    "test": "vitest run tests/engine.test.ts",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "bake:agent": "node scripts/bake-agent.mjs",
    "eval:agent": "node scripts/eval-agent.mjs",
    "obj-to-glb": "node scripts/obj-to-glb.mjs",
    "sync-games": "node scripts/sync-games.mjs",
    "build-cart": "node scripts/build-cart.mjs",
    "zip:aistudio": "node scripts/package-aistudio-zip.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xstate/react": "^5.0.0",
    "ajv": "^8.17.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "idb-keyval": "^6.2.1",
    "lil-gui": "^0.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.170.0",
    "tsx": "^4.19.2",
    "vite": "^6.1.0",
    "xstate": "^5.19.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.1.0",
    "@gltf-transform/extensions": "^4.1.0",
    "@gltf-transform/functions": "^4.1.0",
    "@playwright/test": "^1.50.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.170.0",
    "concurrently": "^9.1.2",
    "meshoptimizer": "^0.22.0",
    "typescript": "~5.7.2",
    "vitest": "^3.0.5"
  }
}
